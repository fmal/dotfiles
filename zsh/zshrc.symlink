# Ghostty shell integration for ZSH. This should be at the top of your zshrc!
# Ghostty auto-injects it only into the shell it launches; this covers nested
# shells (e.g. zmx sessions). The script guards itself against loading twice.
if [[ -n "${GHOSTTY_RESOURCES_DIR}" ]]; then
  builtin source "${GHOSTTY_RESOURCES_DIR}/shell-integration/zsh/ghostty-integration"
fi

# Default editor
if [[ -n "$SSH_CONNECTION" ]]; then
  export EDITOR="nano"
else
  export EDITOR="code -w"
fi

# Prefer US English and use UTF-8
export LANG="en_US.UTF-8"
export LC_ALL="en_US.UTF-8"

# https://consoledonottrack.com/
export DO_NOT_TRACK=1

export HOMEBREW_INSTALL_BADGE="✨"
# Disable Homebrew analytics https://docs.brew.sh/Analytics
export HOMEBREW_NO_ANALYTICS=1
export HOMEBREW_BUNDLE_FILE="$HOME/.Brewfile"

### Paths ###

# Keep PATH entries unique (child shells inherit PATH, then prepend again)
typeset -U path

# Dir paths
export DOTFILES="$HOME/.dotfiles"

# Set up Homebrew environment (PATH, FPATH, etc.)
if [[ -f "/opt/homebrew/bin/brew" ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"  # Apple Silicon
elif [[ -f "/usr/local/bin/brew" ]]; then
  eval "$(/usr/local/bin/brew shellenv)"  # Intel
fi

# Add Homebrew's dir to the end of $fpath, so that we use its completions
# only for those commands that zsh doesn't already know how to complete
if [[ -n "$HOMEBREW_PREFIX" ]]; then
  fpath=(${fpath:#$HOMEBREW_PREFIX/share/zsh/site-functions} $HOMEBREW_PREFIX/share/zsh/site-functions)
fi

# Add homebrew packages to path so they are found before
# macOS's versions of the same software
if [[ -d "$HOMEBREW_PREFIX/opt/coreutils" ]]; then
  path=("$HOMEBREW_PREFIX/opt/coreutils/libexec/gnubin" $path)
fi

if [[ -d "$HOMEBREW_PREFIX/opt/m4/bin" ]]; then
  path=("$HOMEBREW_PREFIX/opt/m4/bin" $path)
fi

# Add dotfiles binaries
if [[ -d "$DOTFILES/bin" ]]; then
  path=("$DOTFILES/bin" $path)
fi

# Add user-local binaries
if [[ -d "$HOME/.local/bin" ]]; then
  path=("$HOME/.local/bin" $path)
fi

# Node-canvas / cairo stuff
export PKG_CONFIG_PATH="/usr/local/lib/pkgconfig:$PKG_CONFIG_PATH"

### Autoloads ###
autoload -Uz zmv

### Plugins ###
source "$DOTFILES/zsh/plugins.zsh"

### Aliases ###
source "$DOTFILES/zsh/aliases.zsh"

### Functions ###
source "$DOTFILES/zsh/functions.zsh"

### Shell integrations ###

if command -v fzf &> /dev/null; then
  source "$DOTFILES/zsh/fzf.zsh"
fi

# Secrets (global config + per-project fnox.toml on cd)
# (completions come with the brew install)
if command -v fnox &> /dev/null; then
  export FNOX_SHELL_OUTPUT=none
  eval "$(fnox activate zsh)"
fi

if command -v zoxide &> /dev/null; then
  eval "$(zoxide init zsh)"
fi

if command -v starship &> /dev/null; then
  eval "$(starship init zsh)"
  # blank line between prompts, but not before the first one
  precmd() { precmd() { print '' } }
fi

if command -v git-gtr &> /dev/null; then
  eval "$(git gtr init zsh --as gwtr)"
fi
