{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 14,
  "env": {
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "MAX_MCP_OUTPUT_TOKENS": "50000",
    "CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD": "1",
    "CLAUDE_CODE_IDLE_COMPACT_MIN_TOKENS": "350000"
  },
  "includeCoAuthoredBy": false,
  "model": "opus",
  "enableAllProjectMcpServers": true,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true
  },
  "syntaxHighlightingDisabled": false,
  "effortLevel": "high",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "terminalProgressBarEnabled": false,
  "voiceEnabled": false,
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [],
    "deny": [
      "mcp__claude_ai_Asana",
      "mcp__claude_ai_Atlassian_MCP",
      "mcp__claude_ai_Atlassian_Rovo",
      "mcp__claude_ai_Attio",
      "mcp__claude_ai_Canva",
      "mcp__claude_ai_ClickUp",
      "mcp__claude_ai_Data_and_Forecasts_MCP",
      "mcp__claude_ai_Fabric_Core_MCP_Server",
      "mcp__claude_ai_Github",
      "mcp__claude_ai_HubSpot",
      "mcp__claude_ai_Mimir",
      "mcp__claude_ai_Miro",
      "mcp__claude_ai_Optimeering_-_Production",
      "mcp__claude_ai_Slack"
    ]
  }
}
