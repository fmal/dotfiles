#!/usr/bin/env zsh
set -euo pipefail

source "${0:A:h:h}/helpers.sh"

command -v brew &> /dev/null || load_brew_env

if ! command -v brew &> /dev/null; then
  # Install Xcode CLT as required by Homebrew
  if ! xcode-select --print-path &> /dev/null; then
    echo 'Installing Xcode CLT. Close dialog box once complete...'
    xcode-select --install &> /dev/null
    # Wait until the Xcode Command Line Tools are installed
    until xcode-select --print-path &> /dev/null; do
      sleep 8
    done
  fi

  # Install Homebrew
  echo 'Installing Homebrew...'
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  load_brew_env
fi

# Install Homebrew packages & apps
if HOMEBREW_NO_AUTO_UPDATE=1 brew bundle check --file="$HOME/.Brewfile" &> /dev/null; then
  echo "Brewfile already satisfied: skipping bundle."
else
  echo 'Installing Homebrew packages and apps...'
  brew update
  brew bundle --file="$HOME/.Brewfile"
  brew cleanup
fi
